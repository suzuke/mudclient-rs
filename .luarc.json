{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace": {
    "library": [
      "scripts/types"
    ]
  },
  "runtime": {
    "version": "Lua 5.4"
  },
  "diagnostics": {
    "globals": [
      "mud",
      "json",
      "message",
      "clean_message",
      "captures"
    ],
    "disable": [
      "lowercase-global"
    ]
  },
  "hint": {
    "enable": true,
    "paramName": "All",
    "paramType": true
  }
}
